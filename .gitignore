*.parquet
*.csv.gz
*.pkl
*.pickle
*.feather
*.h5
*.npy
*.npz

# tabular and figure output (aggregate, but regenerated by the scripts)
*.csv
*.xlsx
*.png
*.tif
*.tiff
*.pdf

